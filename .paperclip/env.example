# Paperclip Environment Configuration
# Copy this file to .env and fill in your values.

# Paperclip Server URL (default: http://localhost:3100)
PAPERCLIP_API_URL=http://localhost:3100

# Agent authentication token (generated by: npx paperclipai agent local-cli <agentRef>)
PAPERCLIP_AGENT_TOKEN=

# Company ID (shown in the Paperclip dashboard after creating a company)
PAPERCLIP_COMPANY_ID=

# Agent ID (assigned when you create an agent in the dashboard)
PAPERCLIP_AGENT_ID=

# LLM Provider API Key (for Claude-based agents)
ANTHROPIC_API_KEY=
